# Base URL used by the browser for API calls.
# Leave empty to call the same origin (/api/...), which the Vite dev proxy forwards to the backend.
# For a production build served from a different origin, the backend must allow CORS for that origin.
VITE_API_BASE_URL=

# Where the Vite dev-server proxy forwards /api requests (development only).
VITE_API_PROXY_TARGET=https://dtpl-api.rdlab.cc

# Mock mode: set to true to skip the backend entirely and authenticate in the browser
# with the credentials below. Development only; never enable in a production build.
VITE_USE_MOCK_API=false
VITE_MOCK_USERNAME=admin
VITE_MOCK_PASSWORD=admin123
VITE_MOCK_ROLE=admin
